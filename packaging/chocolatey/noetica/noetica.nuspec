<?xml version="1.0" encoding="utf-8"?>
<!-- Chocolatey package for the Noetica DESKTOP app (NSIS installer — the same artifact winget
     ships). Replaces the pre-0.4.24 package that wrapped the old agent-machine Windows service
     (NSSM + clone-from-source fallback — both choco-moderation rejections). Version bumps:
     update <version>, the url + checksum in tools/chocolateyInstall.ps1, then choco pack/push. -->
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>noetica</id>
    <version>0.4.24</version>
    <packageSourceUrl>https://github.com/SocioProphet/Noetica/tree/main/packaging/chocolatey</packageSourceUrl>
    <owners>socioprophet</owners>
    <title>Noetica</title>
    <authors>SocioProphet, Inc.</authors>
    <projectUrl>https://socioprophet.ai</projectUrl>
    <projectSourceUrl>https://github.com/SocioProphet/Noetica</projectSourceUrl>
    <licenseUrl>https://github.com/SocioProphet/Noetica/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <bugTrackerUrl>https://github.com/SocioProphet/Noetica/issues</bugTrackerUrl>
    <releaseNotes>https://github.com/SocioProphet/Noetica/releases/tag/v0.4.24</releaseNotes>
    <tags>ai llm local sovereign knowledge-graph governance desktop</tags>
    <summary>Governed, sovereign AI workstation — local-first, cites its sources, abstains instead of guessing.</summary>
    <description><![CDATA[
# Noetica

Noetica is a local-first desktop workstation for governed AI. It runs models on your own
machine, grounds answers in your own knowledge graph, cites its sources, and returns
"insufficient evidence" instead of guessing — so an answer can be defended, not just produced.

- **On-device inference** — your data never has to leave the machine.
- **Verified compute** — calculations are checked, not merely reasoned.
- **Provenance on every answer** — a sealed, replay-exact receipt you can audit.
- **A sovereign knowledge graph** that compounds as you work.

Open source (MIT): https://github.com/SocioProphet/Noetica

**Note:** the installer is currently unsigned — Windows SmartScreen may warn on first run
("More info → Run anyway").
    ]]></description>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
    <file src="legal\**" target="legal" />
  </files>
</package>
